services:
  - type: web
    name: signaliq-api
    runtime: python
    repo: https://github.com/danacioDS/SignalIQ
    branch: main
    buildCommand: |
      cd backend
      pip install -r requirements.txt
    startCommand: |
      cd backend
      python -m app.main
    envVars:
        value: ***REMOVED***
        value: OHKJN60EB6YJYO5L
      - key: LOG_FORMAT
        value: text
      - key: PYTHON_VERSION
        value: 3.12.5
