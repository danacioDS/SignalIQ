# ============================================
# SignalIQ Environment Variables
# ============================================

# API Keys (obligatorias para producción)
ALPHA_VANTAGE_API_KEY=XXXXXXXXXXXXXXXX
TWELVE_DATA_API_KEY=XXXXXXXXXXXXXXXXXXXX


# LLM Keys (opcional, para el pipeline offline)
GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GLM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# LLM Configuration
PRIMARY_LLM=gemini         # gemini | glm | groq | mock
FALLBACK_LLM=groq         # gemini | glm | groq | mock

# Database (opcional, para pipeline offline)
DATABASE_URL=postgresql://user:password@localhost:5432/signaliq

# API Configuration
PORT=10000
CORS_ORIGINS=https://signaliq-zeta-ten.vercel.app,http://localhost:3000

# Security
API_KEY=your_api_key_here  # Opcional - dejar vacío para deshabilitar

# Logging
LOG_FORMAT=json  # json | text (default: text)

# ============================================
# Notas:
# - ALPHA_VANTAGE_API_KEY: https://www.alphavantage.co/support/#api-key
# - TWELVE_DATA_API_KEY: https://twelvedata.com/account
# - GEMINI_API_KEY: https://makersuite.google.com/app/apikey
# - GROQ_API_KEY: https://console.groq.com/keys
# - API_KEY: Cualquier string para autenticación básica
# ============================================
